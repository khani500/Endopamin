{
  "framework": null,
  "outputDirectory": "site",
  "crons": [
    {
      "path": "/api/cron-notify",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/gemini.js": {
      "maxDuration": 30
    },
    "api/exercise-media.js": {
      "maxDuration": 15
    },
    "api/usda-search.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/exercise-media-batch",
      "destination": "/api/exercise-media?__route=batch"
    },
    {
      "source": "/api/exercise-instructions",
      "destination": "/api/exercise-media?__route=instructions"
    }
  ]
}
